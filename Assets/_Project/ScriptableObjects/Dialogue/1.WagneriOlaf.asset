  m_Script: {fileID: 11500000, guid: fe2d31c0a575d374f9b00d77d5d88faf, type: 3}
  m_Name: 1.WagneriOlaf
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speakerName: Raindorf
    speakerPortrait: {fileID: 21300000, guid: cc3daa6a9a1207a429fc0a1b02e63d65, type: 3}
    text: They just keep coming! Gods can only help so much!
    backgroundImage: {fileID: 0}
    flashColor: {r: 0, g: 0, b: 0, a: 0}
    flashFadeInSeconds: -1
    flashHoldSeconds: -1
    flashFadeOutSeconds: -1
  - speakerName: Zavren
    speakerPortrait: {fileID: 21300000, guid: af62107a84f21a44cb1e8b2d56509fb4, type: 3}
    text: At this point we might need some kind of a miracle.
    backgroundImage: {fileID: 0}
    flashColor: {r: 0, g: 0, b: 0, a: 0}
    flashFadeInSeconds: -1
    flashHoldSeconds: -1
    flashFadeOutSeconds: -1
  - speakerName: ???
    speakerPortrait: {fileID: 0}
    text: OY FELLAS, GET DOWN!!!
    backgroundImage: {fileID: 0}
    flashColor: {r: 0, g: 0, b: 0, a: 0}
    flashFadeInSeconds: -1
    flashHoldSeconds: -1
    flashFadeOutSeconds: -1
  - speakerName: 
    speakerPortrait: {fileID: 0}
    text: Strange arcane noises start echoing from behind.
    backgroundImage: {fileID: 0}
    flashColor: {r: 0, g: 0, b: 0, a: 0}
    flashFadeInSeconds: -1
    flashHoldSeconds: -1
    flashFadeOutSeconds: -1
  - speakerName: Abdul
    speakerPortrait: {fileID: 21300000, guid: a4e25b23fb97a46489f95e4bf3dafbd2, type: 3}
    text: Oh, shit! ABOVE US !
    backgroundImage: {fileID: 0}
    flashColor: {r: 0, g: 0, b: 0, a: 0}
    flashFadeInSeconds: -1
    flashHoldSeconds: -1
    flashFadeOutSeconds: -1
  - speakerName: 
    speakerPortrait: {fileID: 0}
    text: Suddenly the sky becomes dark for a moment. A brief spark appear from above
      you and a giant flaming meteor emerges crushing all the remaining wolves.
    backgroundImage: {fileID: 0}
    flashColor: {r: 0, g: 0, b: 0, a: 0}
    flashFadeInSeconds: -1
    flashHoldSeconds: -1
    flashFadeOutSeconds: -1
