%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fe2d31c0a575d374f9b00d77d5d88faf, type: 3}
  m_Name: 1.Start.
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speakerName: ???
    speakerPortrait: {fileID: 21300000, guid: a4e25b23fb97a46489f95e4bf3dafbd2, type: 3}
    text: Woah ...What... happened?
    backgroundImage: {fileID: -6133942402064407019, guid: ca0fd372226fa2f4a902a12c3f1710f2, type: 3}
    flashColor: {r: 0.3137255, g: 0.78431374, b: 0.47058824, a: 1}
    flashFadeInSeconds: 0
    flashHoldSeconds: 1
    flashFadeOutSeconds: -1
  - speakerName: ???
    speakerPortrait: {fileID: 21300000, guid: 5f842b72481fd6043bb45ee3ba848524, type: 3}
    text: Ugh... my head...
    backgroundImage: {fileID: -6133942402064407019, guid: ca0fd372226fa2f4a902a12c3f1710f2, type: 3}
    flashColor: {r: 0, g: 0, b: 0, a: 0}
    flashFadeInSeconds: -1
    flashHoldSeconds: -1
    flashFadeOutSeconds: -1
  - speakerName: ???
    speakerPortrait: {fileID: 21300000, guid: cc3daa6a9a1207a429fc0a1b02e63d65, type: 3}
    text: ...This ... place, is it...
    backgroundImage: {fileID: 0}
    flashColor: {r: 0, g: 0, b: 0, a: 0}
    flashFadeInSeconds: -1
    flashHoldSeconds: -1
    flashFadeOutSeconds: -1
  - speakerName: ???
    speakerPortrait: {fileID: 21300000, guid: ea391b21d3571b74891285752549baee, type: 3}
    text: ICE, SNOW, ARE WE ... IN EISENDORPH ?!
    backgroundImage: {fileID: 0}
    flashColor: {r: 0, g: 0, b: 0, a: 0}
    flashFadeInSeconds: -1
    flashHoldSeconds: -1
    flashFadeOutSeconds: -1
  - speakerName: ???
    speakerPortrait: {fileID: 21300000, guid: a4e25b23fb97a46489f95e4bf3dafbd2, type: 3}
    text: Calm down tiefling, that can't be the case, we were just in Silver Talon
      inn. We couldn't possibly have traveled tens of thousands of kilometers in
      a blink of an eye.
    backgroundImage: {fileID: -6133942402064407019, guid: ca0fd372226fa2f4a902a12c3f1710f2, type: 3}
    flashColor: {r: 0, g: 0, b: 0, a: 0}
    flashFadeInSeconds: -1
    flashHoldSeconds: -1
    flashFadeOutSeconds: -1
  - speakerName: ???
    speakerPortrait: {fileID: 21300000, guid: cc3daa6a9a1207a429fc0a1b02e63d65, type: 3}
    text: 'I think the tiefling is right, this feels like my homeland. I would never
      mistake it, although luckily this is the quieter part... '
    backgroundImage: {fileID: -6133942402064407019, guid: ca0fd372226fa2f4a902a12c3f1710f2, type: 3}
    flashColor: {r: 0, g: 0, b: 0, a: 0}
    flashFadeInSeconds: -1
    flashHoldSeconds: -1
    flashFadeOutSeconds: -1
  - speakerName: ???
    speakerPortrait: {fileID: 21300000, guid: ea391b21d3571b74891285752549baee, type: 3}
    text: So one moment we were fighting those drunk guards, then the next whoosh,
      some green light just transports us to the other side of the continent.
    backgroundImage: {fileID: -6133942402064407019, guid: ca0fd372226fa2f4a902a12c3f1710f2, type: 3}
    flashColor: {r: 0, g: 0, b: 0, a: 0}
    flashFadeInSeconds: -1
    flashHoldSeconds: -1
    flashFadeOutSeconds: -1
  - speakerName: ???
    speakerPortrait: {fileID: 21300000, guid: 5f842b72481fd6043bb45ee3ba848524, type: 3}
    text: 'Most interesting... teleportation mag- Uhhh, what is this? '
    backgroundImage: {fileID: -6133942402064407019, guid: ca0fd372226fa2f4a902a12c3f1710f2, type: 3}
    flashColor: {r: 0, g: 0, b: 0, a: 0}
    flashFadeInSeconds: -1
    flashHoldSeconds: -1
    flashFadeOutSeconds: -1
  - speakerName: ???
    speakerPortrait: {fileID: 21300000, guid: cc3daa6a9a1207a429fc0a1b02e63d65, type: 3}
    text: Aghhh, my hand
    backgroundImage: {fileID: -6133942402064407019, guid: ca0fd372226fa2f4a902a12c3f1710f2, type: 3}
    flashColor: {r: 0, g: 0, b: 0, a: 0}
    flashFadeInSeconds: -1
    flashHoldSeconds: -1
    flashFadeOutSeconds: -1
  - speakerName: ???
    speakerPortrait: {fileID: 21300000, guid: a4e25b23fb97a46489f95e4bf3dafbd2, type: 3}
    text: You feel it too?
    backgroundImage: {fileID: -6133942402064407019, guid: ca0fd372226fa2f4a902a12c3f1710f2, type: 3}
    flashColor: {r: 0, g: 0, b: 0, a: 0}
    flashFadeInSeconds: -1
    flashHoldSeconds: -1
    flashFadeOutSeconds: -1
  - speakerName: ???
    speakerPortrait: {fileID: 0}
    text: It... it looks like a pattern. Must be connected to the green light we
      saw...
    backgroundImage: {fileID: -6133942402064407019, guid: ca0fd372226fa2f4a902a12c3f1710f2, type: 3}
    flashColor: {r: 0, g: 0, b: 0, a: 0}
    flashFadeInSeconds: -1
    flashHoldSeconds: -1
    flashFadeOutSeconds: -1
  - speakerName: ???
    speakerPortrait: {fileID: 0}
    text: There is no other explanation...
    backgroundImage: {fileID: -6133942402064407019, guid: ca0fd372226fa2f4a902a12c3f1710f2, type: 3}
    flashColor: {r: 0, g: 0, b: 0, a: 0}
    flashFadeInSeconds: -1
    flashHoldSeconds: -1
    flashFadeOutSeconds: -1
  - speakerName: ???
    speakerPortrait: {fileID: 21300000, guid: a4e25b23fb97a46489f95e4bf3dafbd2, type: 3}
    text: I don't know about you guys, but I have some things to wrap up and am not
      sticking around here for long.
    backgroundImage: {fileID: -6133942402064407019, guid: ca0fd372226fa2f4a902a12c3f1710f2, type: 3}
    flashColor: {r: 0, g: 0, b: 0, a: 0}
    flashFadeInSeconds: -1
    flashHoldSeconds: -1
    flashFadeOutSeconds: -1
  - speakerName: ???
    speakerPortrait: {fileID: 21300000, guid: ea391b21d3571b74891285752549baee, type: 3}
    text: Agreed, I'm not accustomed to this weather.
    backgroundImage: {fileID: -6133942402064407019, guid: ca0fd372226fa2f4a902a12c3f1710f2, type: 3}
    flashColor: {r: 0, g: 0, b: 0, a: 0}
    flashFadeInSeconds: -1
    flashHoldSeconds: -1
    flashFadeOutSeconds: -1
  - speakerName: ???
    speakerPortrait: {fileID: 21300000, guid: cc3daa6a9a1207a429fc0a1b02e63d65, type: 3}
    text: 'We are in aggreement there, I also have bussines at the South. This complicates
      a great deal... '
    backgroundImage: {fileID: -6133942402064407019, guid: ca0fd372226fa2f4a902a12c3f1710f2, type: 3}
    flashColor: {r: 0, g: 0, b: 0, a: 0}
    flashFadeInSeconds: -1
    flashHoldSeconds: -1
    flashFadeOutSeconds: -1
  - speakerName: ???
    speakerPortrait: {fileID: 21300000, guid: 5f842b72481fd6043bb45ee3ba848524, type: 3}
    text: ...
    backgroundImage: {fileID: -6133942402064407019, guid: ca0fd372226fa2f4a902a12c3f1710f2, type: 3}
    flashColor: {r: 0, g: 0, b: 0, a: 0}
    flashFadeInSeconds: -1
    flashHoldSeconds: -1
    flashFadeOutSeconds: -1
  - speakerName: ???
    speakerPortrait: {fileID: 21300000, guid: ea391b21d3571b74891285752549baee, type: 3}
    text: Well, since we are in aggrement, why don't we introduce ourselves, might
      as well get to know eachother. The road ahead will be long after all...
    backgroundImage: {fileID: -6133942402064407019, guid: ca0fd372226fa2f4a902a12c3f1710f2, type: 3}
    flashColor: {r: 0, g: 0, b: 0, a: 0}
    flashFadeInSeconds: -1
    flashHoldSeconds: -1
    flashFadeOutSeconds: -1
  - speakerName: Zavren
    speakerPortrait: {fileID: 21300000, guid: ea391b21d3571b74891285752549baee, type: 3}
    text: Name's Zavren Kye, a sorcerer.
    backgroundImage: {fileID: -6133942402064407019, guid: ca0fd372226fa2f4a902a12c3f1710f2, type: 3}
    flashColor: {r: 0, g: 0, b: 0, a: 0}
    flashFadeInSeconds: -1
    flashHoldSeconds: -1
    flashFadeOutSeconds: -1
  - speakerName: Abdul
    speakerPortrait: {fileID: 21300000, guid: a4e25b23fb97a46489f95e4bf3dafbd2, type: 3}
    text: Usman Abdul Jalil Sisha, but you can call me Abdul.
    backgroundImage: {fileID: -6133942402064407019, guid: ca0fd372226fa2f4a902a12c3f1710f2, type: 3}
    flashColor: {r: 0, g: 0, b: 0, a: 0}
    flashFadeInSeconds: -1
    flashHoldSeconds: -1
    flashFadeOutSeconds: -1
  - speakerName: Raindorf
    speakerPortrait: {fileID: 21300000, guid: cc3daa6a9a1207a429fc0a1b02e63d65, type: 3}
    text: Raindorf Grayhill, follower of the Judicator at your service.
    backgroundImage: {fileID: -6133942402064407019, guid: ca0fd372226fa2f4a902a12c3f1710f2, type: 3}
    flashColor: {r: 0, g: 0, b: 0, a: 0}
    flashFadeInSeconds: -1
    flashHoldSeconds: -1
    flashFadeOutSeconds: -1
  - speakerName: Sicur
    speakerPortrait: {fileID: 21300000, guid: cc3daa6a9a1207a429fc0a1b02e63d65, type: 3}
    text: ...Sicur Mak Aye.
    backgroundImage: {fileID: -6133942402064407019, guid: ca0fd372226fa2f4a902a12c3f1710f2, type: 3}
    flashColor: {r: 0, g: 0, b: 0, a: 0}
    flashFadeInSeconds: -1
    flashHoldSeconds: -1
    flashFadeOutSeconds: -1
  - speakerName: Zavren
    speakerPortrait: {fileID: 21300000, guid: ea391b21d3571b74891285752549baee, type: 3}
    text: Well then, nice to meet you guys. I guess we should start wi-
    backgroundImage: {fileID: -6133942402064407019, guid: ca0fd372226fa2f4a902a12c3f1710f2, type: 3}
    flashColor: {r: 0, g: 0, b: 0, a: 0}
    flashFadeInSeconds: -1
    flashHoldSeconds: -1
    flashFadeOutSeconds: -1
  - speakerName: Abdul
    speakerPortrait: {fileID: 21300000, guid: a4e25b23fb97a46489f95e4bf3dafbd2, type: 3}
    text: Seems like the wildlife came to say hello. Get ready!
    backgroundImage: {fileID: -6133942402064407019, guid: ca0fd372226fa2f4a902a12c3f1710f2, type: 3}
    flashColor: {r: 0, g: 0, b: 0, a: 0}
    flashFadeInSeconds: -1
    flashHoldSeconds: -1
    flashFadeOutSeconds: -1
